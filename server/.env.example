# HTTP port for the API + Socket.IO server
PORT=3000

# Allowed CORS origin for the Vite client
CLIENT_ORIGIN=http://localhost:5173

# Telegram Bot token for initData HMAC validation.
# Optional — auth is skipped when empty.
TELEGRAM_BOT_TOKEN=

# Maximum number of concurrent Stockfish processes across all games.
# Each game holds at most one engine slot.
MAX_ENGINES=4
