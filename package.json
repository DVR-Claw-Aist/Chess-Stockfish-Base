{
  "name": "chess-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,client \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "start": "npm start --workspace=server",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "workspaces": ["server", "client"]
}
